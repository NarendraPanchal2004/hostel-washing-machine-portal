# ==============================================================================
# Hostel Washing Machine Booking Portal - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit secrets to public git repositories)
# 2. Get your SUPABASE_URL and SUPABASE_ANON_KEY from:
#    https://app.supabase.com -> Project Settings -> API
# ==============================================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client-side queries)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# (Optional) Service Role Key - ONLY for automated backend verification tests
# NEVER expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# (Optional) Admin credentials for running verification tests
ADMIN_EMAIL=admin@hostel.edu
ADMIN_PASSWORD=your_secure_password
